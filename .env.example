# Optional: you can paste your AI key in the app's Settings page instead.
# Copy this file to .env.local and fill in any one key. Match data needs no keys.
# If more than one is set, the first below is used unless you pick one in Settings.

# Claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ChatGPT: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Grok: https://console.x.ai
XAI_API_KEY=
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter, any model: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional model override per provider: ANTHROPIC_MODEL, OPENAI_MODEL, XAI_MODEL, GEMINI_MODEL, OPENROUTER_MODEL
