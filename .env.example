# Optional: you can paste keys in the app's Settings page instead.
# Copy this file to .env.local and fill in whichever keys you have.

# Which AI reads your slip: "anthropic" (Claude) or "openai" (ChatGPT)
AI_PROVIDER=anthropic

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5

# https://the-odds-api.com (free tier: 500 requests/month)
ODDS_API_KEY=
